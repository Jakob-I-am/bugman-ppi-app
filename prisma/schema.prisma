generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ---------- Better Auth tables ----------

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String    @default("customer") // "admin" | "customer"
  phone         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  passkeys      Passkey[]
  jobs          Job[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// Passkeys (Face ID, fingerprint, security key). Only the admin can register them.
model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  aaguid       String?
  createdAt    DateTime? @default(now())

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

// ---------- App tables ----------

enum JobStatus {
  DRAFT
  FINALISED
}

enum ReportType {
  BUILDING_AND_PEST
  BUILDING
  TIMBER_PEST
}

enum FindingCategory {
  MAJOR_DEFECT
  SAFETY_HAZARD
  MINOR_DEFECT
  TIMBER_PEST
  CONDUCIVE_CONDITION
  FURTHER_INSPECTION
  OBSERVATION
}

model Job {
  id              String          @id @default(cuid())
  number          Int             @unique @default(autoincrement())
  customerId      String
  customer        User            @relation(fields: [customerId], references: [id])
  propertyAddress String
  reportType      ReportType      @default(BUILDING_AND_PEST)
  status          JobStatus       @default(DRAFT)
  /// Answers for the fixed report parts (src/lib/report/frame.ts)
  answers         Json            @default("{}")
  finalisedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  sections        ReportSection[]
  photos          Photo[]

  @@index([customerId, status])
}

/// One area of the report (a room, the roof space...), added as needed.
model ReportSection {
  id          String    @id @default(cuid())
  jobId       String
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  templateKey String
  title       String
  position    Int
  answers     Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  findings    Finding[]
  photos      Photo[]

  @@index([jobId, position])
}

/// A defect, safety hazard, pest finding or recommendation within a section.
model Finding {
  id             String          @id @default(cuid())
  sectionId      String
  section        ReportSection   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  category       FindingCategory
  element        String          @default("")
  location       String          @default("")
  description    String          @default("")
  recommendation String          @default("")
  /// Category-specific choice, e.g. termite type or specialist to refer to
  detail         String          @default("")
  position       Int
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  photos         Photo[]

  @@index([sectionId, position])
}

/// A photo belongs to a finding, or to a section generally.
model Photo {
  id            String         @id @default(cuid())
  jobId         String
  job           Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sectionId     String?
  section       ReportSection? @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  findingId     String?
  finding       Finding?       @relation(fields: [findingId], references: [id], onDelete: Cascade)
  pathname      String
  thumbPathname String
  takenAt       DateTime?
  createdAt     DateTime       @default(now())

  @@index([jobId])
  @@index([sectionId])
  @@index([findingId])
}

model Enquiry {
  id              String   @id @default(cuid())
  name            String
  email           String
  phone           String
  propertyAddress String
  service         String
  neededBy        String
  message         String
  createdAt       DateTime @default(now())
}
